    {
        "id": "80d5f8136b65c6a6",
        "type": "function",
        "z": "2e02f1dba210a459",
        "name": "Atur Batas Suhu",
        "func": "let batas = Number(msg.payload.batas);\n\nif (!Number.isFinite(batas) || batas < 1 || batas > 100) {\n    msg.statusCode = 400;\n    msg.payload = {\n        sukses: false,\n        pesan: \"Batas suhu harus antara 1 sampai 100\"\n    };\n    return msg;\n}\n\nflow.set(\"threshold\", batas);\n\nmsg.payload = {\n    sukses: true,\n    pesan: \"Threshold berhasil diperbarui\",\n    batas_suhu: batas\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 740,
        "y": 580,
        "wires": [
            [
                "5fad2f223e4d4cbd"
            ]
        ]
    },
    {
        "id": "1ab31e77fe4cc1bb",
        "type": "function",
        "z": "2e02f1dba210a459",
        "name": "Cek Threshold Suhu",
        "func": "let data = msg.payload;\nlet batas = flow.get(\"threshold\") || 35;\n\nif (Number(data.suhu) > batas) {\n    msg.payload = {\n        notifikasi: \"PERINGATAN! Suhu melewati batas!\",\n        suhu_sekarang: data.suhu,\n        batas_suhu: batas\n    };\n\n    return msg;\n}\n\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 320,
        "wires": [
