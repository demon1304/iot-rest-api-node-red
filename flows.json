    {
        "id": "887fa85e1f947178",
        "type": "function",
        "z": "2e02f1dba210a459",
        "name": "Kirim Perintah Lampu",
        "func": "let perintah = msg.payload.perintah;\n\nif (perintah !== \"ON\" && perintah !== \"OFF\") {\n    msg.statusCode = 400;\n    msg.payload = { pesan: \"Perintah harus ON atau OFF\" };\n    return msg;\n}\n\nmsg.topic = \"kelas/iot/lampu/control\";\nmsg.payload = perintah;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
